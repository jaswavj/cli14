# Normalize line endings for all text files to LF in the repository
* text=auto eol=lf

# Explicitly LF for web source files
*.html   text eol=lf
*.jsp    text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf

# Binary files — no line-ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
*.jar    binary
*.class  binary
